# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/fluentpath

# JWT
JWT_SECRET=change-me-in-production

# Number of practice sessions in a stage (default: 30)
STAGE_N=30

# --- Cloud video storage (AWS S3) ---
# When all three are set, videos upload to S3 and full URLs are saved in MongoDB.
# Leave unset to keep storing files under backend/uploads/
AWS_ACCESS_KEY_ID=AKIA45XNJRRED7RDM3ES
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
# Optional: CloudFront or custom CDN base (no trailing slash)
# S3_PUBLIC_BASE_URL=https://d1234.cloudfront.net

# CORS (comma-separated origins for dev)
# CORS_ORIGIN=http://localhost:5173
